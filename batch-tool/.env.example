# Copy this to .env and fill in your Railway MySQL credentials
# Get these from Railway dashboard → MySQL service → Connect tab

DB_HOST=your-railway-mysql-host.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=railway

# Gemini API Key (same as backend)
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Vision (optional, for better OCR)
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key
