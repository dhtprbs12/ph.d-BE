# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=petfood_analyzer

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Vision API (primary label OCR — ingredient text verbatim;
# Gemini handles product metadata and risk assessment). Plain API key auth
# is fine — restrict it to the Vision API in the GCP console.
GOOGLE_CLOUD_VISION_API_KEY=your-cloud-vision-api-key

# Cache
CACHE_TTL=3600

